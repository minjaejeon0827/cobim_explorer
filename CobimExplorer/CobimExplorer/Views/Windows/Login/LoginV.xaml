<!--  TODO : 추후 로그인 뷰(LoginV.xaml) 소스파일 명칭 (LogInV.xaml)로 변경 예정 (2023.11.30 jbh)  -->
<Window x:Class="CobimExplorer.Views.Windows.Login.LoginV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CobimExplorer.Converters"
        xmlns:local="clr-namespace:CobimExplorer.Views.Windows.Login"
        xmlns:utilsText="clr-namespace:CobimExplorer.Utils.Text"
        xmlns:utilsPassword="clr-namespace:CobimExplorer.Utils.Password"
        xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Windows.Login"
        xmlns:s="https://github.com/canton7/Stylet"
        s:View.ActionTarget="{Binding LoginVM}"
        d:DataContext="{d:DesignInstance Type=vm:LoginVM}" 
        mc:Ignorable="d"
        Title="COBIM Explorer" 
        Height="700" 
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    <!--  TODO : 아래 주석친 로그인 뷰모델(LoginVM.cs) 바인딩 하는 XAML 코드 필요시 참고 (2024.09.03 jbh)  -->
    <!--  <Window.DataContext>
        <Binding Path="LoginVM" />
    </Window.DataContext>  -->
    
    <!--  TODO : 로그인 뷰 (LoginV.xaml) XAML 코드 <PasswordBox> 영역 Hint(PlaceHolder와 같은 기능 - 반 투명 회색글자 "비밀번호를 입력하세요") 구현 (2023.08.23 jbh)  -->
    <!--  TODO : PasswordBoxHelper.cs 에 의존 프로퍼티 IsMonitoring, PasswordLength 구현 (2023.08.23 jbh)  -->
    <!--  참고 URL - https://yimjang.tistory.com/entry/WPF-Textbox-Watermark-Passwordbox-%ED%8C%A8%EC%8A%A4%EC%9B%8C%EB%93%9C%EB%B0%95%EC%8A%A4%EC%97%90-%ED%9E%8C%ED%8A%B8-%EB%84%A3%EA%B8%B0  -->
    <!--  참고 2 URL - https://stackoverflow.com/questions/1607066/wpf-watermark-passwordbox-from-watermark-textbox  -->
    <Window.Resources>
        <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}">
            <Setter Property="utilsPassword:PasswordBoxHelper.IsMonitoring" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border Name="pwBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="true">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <TextBlock x:Name="txtPrompt"
                                           Text="비밀번호를 입력하세요" 
                                           Margin="5,0,0,0"
                                           Foreground="{StaticResource App.Brush.Themes.Common.Gray}" 
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="pwBorder"
                                        Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="utilsPassword:PasswordBoxHelper.PasswordLength" Value="0">
                                <Setter Property="Visibility" TargetName="txtPrompt" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  정수 값과 문자열 값을 받는 MultiValueConverter 클래스 "ExplorerConverter"  -->
        <converters:ExplorerConverter x:Key="ExplorerConverter"   />

        <!--  TODO : 바인딩한 객체(프로퍼티)에 할당된 값이 True면 False, False면 True로 반대의 값으로 리턴되는 Converter 클래스 "InvertBooleanConverter.cs" 구현 (2024.09.03 jbh)  -->
        <!--  참고 URL - https://codekiller.tistory.com/581 -->
        <!--  참고 2 URL - https://devbong.tistory.com/41   -->
        <!--  참고 3 URL - https://benstagram.tistory.com/203  -->
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"  />
    </Window.Resources>

    <Border BorderBrush="{StaticResource App.Brush.Themes.Common.Black}"
            BorderThickness="1">
        <StackPanel>
            <!-- 닫기 버튼 -->
            <!--  Command="{s:Action ExitApp, ActionNotFound=Disable}"  -->
            <Button x:Name="ExitBtn" 
                    Command="{Binding ExitCommand}"
                    Background="{StaticResource App.Brush.Themes.Common.Transparent}"
                    BorderBrush="{StaticResource App.Brush.Themes.Common.Transparent}"
                    HorizontalAlignment="Right">
                <Canvas Height="25" Width="35">
                    <Line X1="12" Y1="8" 
                              X2="22" Y2="18"    
                              Stroke="{StaticResource App.Brush.Themes.Common.Black}"
                              StrokeThickness="2" />

                    <Line X1="12" Y1="18"    
                              X2="22" Y2="8"  
                              Stroke="{StaticResource App.Brush.Themes.Common.Black}"
                              StrokeThickness="2" />
                </Canvas>
                <!--  TODO : 아래 주석친 코드 필요시 참고 (2024.08.26 jbh)  -->
                <!--  TODO : <Button> 영역 <Image> 파일 ExitBtn.png 추가 (2023.08.17 jbh)  -->
                <!--  참고 URL - https://drbeeeye.tistory.com/45  -->
                <!--  <Button.Content>
                          <Image x:Name="ExitBtnImg" Source="/Resources/ExitBtn.png"/>
                      </Button.Content>  -->
            </Button>

            <!--  TODO : 아래 주석친 코드 필요시 참고 (2024.08.26 jbh)  -->
            <!--  <StackPanel Width="30" HorizontalAlignment="Right">
                --><!--<StackPanel Margin="16,10,0,6" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="Dark Mode" />
        
                <ToggleButton Cursor="Hand" 
                              ToolTip="Enable Dark Mode" 
                              Margin="12,0,8,0"
                              x:Name="themeToggle"
                              IsChecked="{Binding IsDarkTheme}"
                              Click="toggleTheme" />
                </StackPanel>  -->
            
                <!--  <Button Margin="0,8,0,0"
                              Content="Help Me"
                              ToolTip="Having Trouble Logging In?" />  -->
            
                <!--  닫기 버튼  -->
                <!--  Command="{s:Action ExitApp, ActionNotFound=Disable}"--><!--
                <Button x:Name="ExitBtn" 
                        Command="{Binding ExitCommand}">
                    --><!--  TODO : <Button> 영역 <Image> 파일 ExitBtn.png 추가 (2023.08.17 jbh)  -->
                    <!--  참고 URL - https://drbeeeye.tistory.com/45  --><!--
                    <Button.Content>
                        <Image x:Name="ExitBtnImg" Source="/Resources/ExitBtn.png"/>
                    </Button.Content>
                </Button>
            </StackPanel>  -->

            <!--  Resources 폴더 -> Logo.PNG(png) 파일 <Image>영역 Source 바인딩(등록) 방법  -->
            <!--  참고 URL - https://m.blog.naver.com/PostView.naver?isHttpsRedirect=true&blogId=baejun_k&logNo=221285690364  -->
            <!--  로고 이미지  -->
            <Image Margin="0,20,0,0" Source="/Resources/CobimLogo.png" Height="70" />

            <Image Margin="0,10,0,0" Source="/Resources/CorporateLogo.png" Height="70"/>

            <!--  Welcome to COBIM!  -->
            <TextBlock Margin="0,20,0,10"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       FontWeight="Bold"
                       Text="Welcome to COBIM!" />

            <!--  Log in to your existing account  -->
            <!--  <TextBlock FontSize="17"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Text="Log in to your existing account" />  -->

            <!--  TODO : <TextBox> 영역에 PlaceHolder(Watermark) "그룹 아이디를 입력하세요" 구현 (2023.12.01 jbh)  -->
            <!--  참고 URL - https://blissfuljoon.tistory.com/374  -->
            <!--  참고 2 URL - https://kjun.kr/1127  -->
            <!--  TODO : <TextBox>에 적힌 텍스트 <TextBox> 영역 중앙 정렬 구현 VerticalContentAlignment="Center" (2023.12.01 jbh)  -->
            <!--  참고 URL - https://drbeeeye.tistory.com/9  -->
            <StackPanel Margin="0,20,0,0" Width="300">
                <TextBlock Text="그룹 아이디*" FontWeight="Bold" />
                <!--  TODO : <Border> 태그 모서리 둥글게 하기 위해 속성 "CornerRadius" 사용 (2024.09.05 jbh)  -->
                <Border Margin="0,5,0,0" 
                        BorderThickness="2" 
                        BorderBrush="{StaticResource App.Brush.Login.BorderBrush}" 
                        Height="40"
                        CornerRadius="5">
                    <Grid Margin="0,2,0,2">
                        <!--  그룹 아이디 입력  -->
                        <TextBox x:Name="txtTenantId" 
                                 Text="{Binding TenantId}" 
                                 utilsText:TextBoxHelper.UseOnPropertyChanged="True"
                                 Height="50" 
                                 Width="300" 
                                 FontSize="18" 
                                 HorizontalAlignment="Left" 
                                 VerticalAlignment="Center" 
                                 VerticalContentAlignment="Center" />

                        <TextBlock Text="그룹 아이디를 입력하세요" 
                                   Margin="5,0,0,0" 
                                   FontSize="18" 
                                   IsHitTestVisible="False" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Foreground" Value="{StaticResource App.Brush.Themes.Common.Gray}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtTenantId}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  TODO : <TextBox> 영역에 PlaceHolder(Watermark) "Enter Username" 구현 (2023.08.17 jbh)  -->
            <!--  참고 URL - https://blissfuljoon.tistory.com/374  -->
            <!--  참고 2 URL - https://kjun.kr/1127  -->
            <!--  TODO : <TextBox>에 적힌 텍스트 <TextBox> 영역 중앙 정렬 구현 VerticalContentAlignment="Center" (2023.08.17 jbh)  -->
            <!--  참고 URL - https://drbeeeye.tistory.com/9  -->
            <StackPanel Margin="0,20,0,0" Width="300">
                <TextBlock Text="사용자 아이디*" FontWeight="Bold" />
                <!--  TODO : <Border> 태그 모서리 둥글게 하기 위해 속성 "CornerRadius" 사용 (2024.09.05 jbh)  -->
                <Border Margin="0,5,0,0" 
                        BorderThickness="2" 
                        BorderBrush="{StaticResource App.Brush.Login.BorderBrush}" 
                        Height="40"
                        CornerRadius="5">
                    <Grid Margin="0,2,0,2">
                        <!--  TODO : <TextBox> 영역 UpdateSourceTrigger 필요시 추가 예정 (2023.08.23 jbh)  -->
                        <!--  참고 URL - https://afsdzvcx123.tistory.com/entry/C-WPF-WPF-MVVM-%ED%8C%A8%ED%84%B4-%EC%9D%B4%EC%9A%A9%ED%95%98%EC%97%AC-TextBox-%EC%BB%A8%ED%8A%B8%EB%A1%A4-%EB%AC%B8%EC%9E%90-%EC%9E%85%EB%A0%A5-%EA%B0%90%EC%A7%80%ED%95%98%EA%B8%B0  -->
                        <!--  TODO : Attached Property 기능 "TextBoxHelper.cs" 구현 (2023.08.23 jbh)  -->
                        <!--  유튜브 참고 URL - https://youtu.be/An7kwDYt3OQ  -->
                        <!--  사용자 아이디 입력  -->
                        <TextBox x:Name="txtLoginId" 
                                 Text="{Binding LoginId}" 
                                 utilsText:TextBoxHelper.UseOnPropertyChanged="True"
                                 Height="50" 
                                 Width="300" 
                                 FontSize="18" 
                                 HorizontalAlignment="Left" 
                                 VerticalAlignment="Center" 
                                 VerticalContentAlignment="Center" />

                        <TextBlock Text="아이디를 입력하세요" 
                                   Margin="5,0,0,0" 
                                   FontSize="18" 
                                   IsHitTestVisible="False" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Foreground" Value="{StaticResource App.Brush.Themes.Common.Gray}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtLoginId}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,20,0,0" Width="300">
                <TextBlock Text="비밀번호*" FontWeight="Bold" />
                <!--  TODO : <Border> 태그 모서리 둥글게 하기 위해 속성 "CornerRadius" 사용 (2024.09.05 jbh)  -->
                <Border Margin="0,5,0,0" 
                        BorderThickness="2" 
                        BorderBrush="{StaticResource App.Brush.Login.BorderBrush}" 
                        Height="40"
                        CornerRadius="5">
                    <Grid Margin="0,2,0,2">
                        <!--  TODO : Attached Property 기능 "PasswordBoxHelper.cs" 구현 (2023.08.23 jbh)  -->
                        <!--  유튜브 참고 URL - https://youtu.be/An7kwDYt3OQ  -->
                        <!--  TODO : <PasswordBox> 영역에 비밀번호 보안 문제로 인하여 프로퍼티 "Password"가 바인딩이 안 되므로  -->
                        <!--         PasswordBoxHelper.cs 소스파일 -> 의존 프로퍼티 "BoundPassword" 구현 완료 (2023.08.24 jbh)  -->
                        <!--  비밀번호 입력  -->
                        <PasswordBox PasswordChar="*"
                                     utilsPassword:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                                     Height="50" 
                                     Width="300" 
                                     FontSize="18" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     VerticalContentAlignment="Center" />


                        <!--  TODO : <TextBox> 영역 UpdateSourceTrigger 추가 (2023.08.21 jbh)  -->
                        <!--  참고 URL - https://afsdzvcx123.tistory.com/entry/C-WPF-WPF-MVVM-%ED%8C%A8%ED%84%B4-%EC%9D%B4%EC%9A%A9%ED%95%98%EC%97%AC-TextBox-%EC%BB%A8%ED%8A%B8%EB%A1%A4-%EB%AC%B8%EC%9E%90-%EC%9E%85%EB%A0%A5-%EA%B0%90%EC%A7%80%ED%95%98%EA%B8%B0  -->
                        <!--  <TextBox Name="txtPassword" 
                                       Text="{Binding PassWord, UpdateSourceTrigger=PropertyChanged}" 
                                       Height="50" 
                                       Width="300" 
                                       FontSize="18" 
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Center" 
                                       VerticalContentAlignment="Center" />  -->
                        
                        <!--  <TextBlock Text="비밀번호를 입력하세요" 
                                         Margin="5,0,0,0" 
                                         FontSize="18" 
                                         IsHitTestVisible="False" 
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Setter Property="Foreground" Value="{StaticResource App.Brush.Themes.Common.Gray}"/>
        
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtPassword}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>  -->  
                    </Grid>
                </Border>
            </StackPanel>

            <!--  TODO : 바인딩한 객체(프로퍼티)에 할당된 값이 True면 False, False면 True로 반대의 값으로 리턴되는 Converter 클래스 "InvertBooleanConverter.cs" 구현 (2024.09.03 jbh)  -->
            <!--  참고 URL - https://codekiller.tistory.com/581    -->
            <!--  참고 2 URL - https://devbong.tistory.com/41      -->
            <!--  참고 3 URL - https://benstagram.tistory.com/203  -->

            <!--  TODO : "로그인 버튼"에 속하는 속성 "IsEnabled"에 BindingMode(바인딩 모드) 속성 Mode=OneWay 로 설정하여 뷰모델에 구현한 프로퍼티 "IsLoginWorking" 값이 바뀌면 뷰로 변경된 값이 출력되도록 구현 (2024.09.04 jbh)  -->
            <!--  참고 URL - https://hihaoun.tistory.com/entry/C-%EB%B0%94%EC%9D%B8%EB%94%A9-onetime-oneway-twoway-onewaytosource  -->
            
            <!--  로그인 버튼  -->
            <!--  Command="{s:Action LoginAsync, ActionNotFound=Disable}"  -->
            <Button x:Name="LoginBtn"  
                    Margin="0,30,0,0"
                    Height="40"
                    Width="300" 
                    FontSize="18"
                    Content="로그인"
                    Command="{Binding LoginCommand}"
                    Foreground="{StaticResource App.Brush.Themes.Common.White}"
                    Background="{StaticResource App.Brush.Themes.Common.Blue}"
                    IsEnabled="{Binding IsLoginWorking, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}">
                <!--  TODO : 버튼 "로그인" 모서리 둥글게 설정하기 위해 아래처럼 속성 "CornerRadius" 사용해서 스타일 구현 (2024.09.05 jbh)  -->
                <!--  참고 URL - https://ghostweb.tistory.com/1160  -->
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                </Button.Resources>
                <Button.CommandParameter>
                    <!--  TODO : 버튼 멀티 바인딩 시 프로퍼티 Path 사용 (2024.03.18 jbh) -->
                    <!--  참고 URL - https://icodebroker.tistory.com/entry/CWPF-MultiBinding-%EC%97%98%EB%A6%AC%EB%A8%BC%ED%8A%B8-Converter-%EC%86%8D%EC%84%B1%EC%97%90%EC%84%9C-IMultiValueConverter-%EC%9D%B8%ED%84%B0%ED%8E%98%EC%9D%B4%EC%8A%A4-%EA%B5%AC%ED%98%84-%EA%B0%9D%EC%B2%B4%EB%A5%BC-%EC%82%AC%EC%9A%A9%ED%95%B4-%EB%B0%94%EC%9D%B8%EB%94%A9%ED%95%98%EA%B8%B0-2  -->
                    <MultiBinding Converter="{StaticResource ExplorerConverter}">
                        <!--  TODO : 버튼 멀티 바인딩 구현(2024.03.18 jbh)  -->
                        <!--  참고 URL - https://chat.openai.com/c/d50bfec5-a101-4fc2-bf83-360d19f725ac  -->

                        <!--  멀티 바인딩할 값들  -->
                        <!--  그룹 아이디    -->
                        <Binding ElementName="txtTenantId" Path="Text" />

                        <!--  로그인 아이디    -->
                        <Binding ElementName="txtLoginId" Path="Text" />

                        <!--  로그인 패스워드  -->
                        <!--  TODO : 추후 로그인 버튼에 멀티 바인딩된 속성 중 로그인 패스워드 의존 프로퍼티 "BoundPasswordProperty"에  -->
                        <!--         바인딩된 패스워드 문자열을 로그인 뷰모델(LoginVM.cs)에 속한  -->
                        <!--         비동기 메서드 "LoginAsync"의 메서드 파라미터 "object obj"로 가져올 수 있도록 구현 예정 (2024.03.18 jbh)  -->
                        <Binding Source="{x:Static utilsPassword:PasswordBoxHelper.BoundPasswordProperty}" />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>

            <!--  TODO : 버튼 "테스트" 필요시 구현 예정 (2023.08.17 jbh)  -->
            <!--  테스트 버튼  -->
            <!--  Command="{s:Action TestAsync, ActionNotFound=Disable}" -->
            <!--  <Button x:Name="TestBtn"
                          Margin="0,30,0,0"
                          Height="40"
                          Width="300" 
                          FontSize="18"
                          Content="테스트"
                          Command="{Binding TestCommand}"
                          Background="{StaticResource App.Brush.Themes.Common.Blue}"
                          Foreground="{StaticResource App.Brush.Themes.Common.White}"  />  -->  

            <TextBlock Margin="0,60,0,0"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Text="© COBIM. 디지털협업플랫폼 연구단" />
        </StackPanel>
    </Border>
</Window>
