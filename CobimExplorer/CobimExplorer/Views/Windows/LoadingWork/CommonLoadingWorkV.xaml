<Window x:Class="CobimExplorer.Views.Windows.LoadingWork.CommonLoadingWorkV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Windows.LoadingWork"
        xmlns:s="https://github.com/canton7/Stylet"
        xmlns:local="clr-namespace:CobimExplorer.Views.Windows.LoadingWork"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="CommonLoadingWorkV"
        s:View.ActionTarget="{Binding CommonLoadingWorkVM}"
        d:DataContext="{d:DesignInstance Type=vm:CommonLoadingWorkVM}"
        Height="180" 
        Width="290"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    <Grid>
        <Border BorderBrush="{StaticResource App.Brush.Themes.Common.Black}"
                BorderThickness="2">
            <StackPanel Orientation="Vertical">
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding Message}"
                           TextAlignment="Center"
                           FontSize="20" 
                           FontWeight="Bold" />

                <Image Margin="0,20,0,0"
                       Stretch="Uniform"
                       Height="50"
                       gif:ImageBehavior.AnimatedSource="/Resources/CommonProgress.gif" />

                <TextBlock Margin="0,20,0,10" 
                           Text="잠시만 기다려 주세요..."
                           TextAlignment="Center"
                           FontSize="15" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
