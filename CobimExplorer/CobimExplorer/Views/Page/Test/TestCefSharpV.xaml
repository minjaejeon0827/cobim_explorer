<UserControl x:Class="CobimExplorer.Views.Page.Test.TestCefSharpV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CobimExplorer.Views.Page.Test"
             xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Page.Test"
             xmlns:s="https://github.com/canton7/Stylet"
             s:View.ActionTarget="{Binding TestCefSharpVM}"
             d:DataContext="{d:DesignInstance vm:TestCefSharpVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource App.Brush.Themes.Common.White}">
        <cef:ChromiumWebBrowser x:Name="Browser" Address="https://www.google.com/"/>
    </Grid>
</UserControl>
