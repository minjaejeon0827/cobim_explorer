<UserControl x:Class="CobimExplorer.Views.Page.Test.TestWebBrowserV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CobimExplorer.Views.Page.Test"
             xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Page.Test"
             xmlns:s="https://github.com/canton7/Stylet"
             s:View.ActionTarget="{Binding TestWebBrowserVM}"
             d:DataContext="{d:DesignInstance vm:TestWebBrowserVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource App.Brush.Themes.Common.White}">
        <!--  <TextBlock Text="웹 브라우저 테스트 화면" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center" 
                         FontSize="50"/>  -->

        <!--  TODO : 컨트롤 <WebBrowser> 사용하여 탐색기 응용 프로그램 TabItem Content 영역 안에 
                     웹브라우저 화면 출력 후 검색어 입력 및 엔터키 또는 그 외 버튼 클릭시 스크립트 오류 발생
                     해당 스크립트 오류를 해결하기 위해 
                     아래처럼 Navigated 이벤트 메서드 "TestWebBrowser_Navigated" 구현 및 static 메서드 "SetSilent" 구현 (2024.08.07 minjae)  -->
        <!--  참고 URL - https://stackoverflow.com/questions/6138199/wpf-webbrowser-control-how-to-suppress-script-errors  -->
        <WebBrowser x:Name="TestWebBrowser" Source="https://www.google.com/" Navigated="{s:Action TestWebBrowser_Navigated}"/>
    </Grid>
</UserControl>
