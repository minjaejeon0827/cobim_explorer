<UserControl x:Class="CobimExplorer.Views.Page.Project.BIM360.HubBox.HubBoxV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CobimExplorer.Views.Page.Project.BIM360.HubBox"
             xmlns:cef="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Page.Project.BIM360.HubBox"
             xmlns:s="https://github.com/canton7/Stylet"
             s:View.ActionTarget="{Binding HubBoxVM}"
             d:DataContext="{d:DesignInstance vm:HubBoxVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource App.Brush.Themes.Common.White}">
        <!--  <cef:ChromiumWebBrowser x:Name="HubBoxBrowser" Address="http://192.168.0.68:8100/convert/list" />  -->
        <cef:ChromiumWebBrowser x:Name="HubBoxBrowser" Address="{Binding WebConvertListURL}" />
    </Grid>
</UserControl>
