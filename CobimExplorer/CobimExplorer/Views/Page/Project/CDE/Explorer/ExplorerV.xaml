                                        <!--  참고 URL - https://blog.naver.com/jjid0247/222111885157  -->
                                        <!--  참고 2 URL - https://nonstop-antoine.tistory.com/33  -->
                                        <ItemsControl ItemsSource="{Binding TeamList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
