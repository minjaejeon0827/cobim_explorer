                                                        <TextBlock Text=">" Margin="5,5,0,5"/>

                                                        <TextBlock Text="{Binding exp_TreeName}" Margin="5"/>

                                                        <!--  TODO : 파일(컨테이너) 신규 등록의 경우 COBIM 웹 사이트(인재 INC)에서만 사용하는 기능이고 CDE 탐색기 응용 프로그램에서는 사용 안 하는 걸로 소통 완료.  -->
