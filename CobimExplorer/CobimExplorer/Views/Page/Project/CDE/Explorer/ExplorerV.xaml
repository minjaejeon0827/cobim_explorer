                                                  SelectionMode="Extended"
                                                  RowHeaderWidth="0"
                                                  AutoGenerateColumns="False"
                                                  BorderBrush="{StaticResource App.Brush.Themes.Winter.Black.20}"
                                                  BorderThickness="2"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False">
