                                                    <!--  참고 3 URL - https://stackoverflow.com/questions/1350598/passing-two-command-parameters-using-a-wpf-binding -->
                                                    <!--  참고 4 URL - https://stackoverflow.com/questions/23499671/wpf-multibinding-button-isenabled-with-textboxes  -->
                                                    <!--  참고 5 URL - https://stackoverflow.com/questions/22084611/wpf-how-to-bind-together-two-properties-bound-to-two-different-controls -->
                                                    <Button.CommandParameter>
                                                        <!--  TODO : 버튼 멀티 바인딩 시 프로퍼티 Path 사용 (2023.09.19 jbh)  -->
                                                        <!--  참고 URL - https://icodebroker.tistory.com/entry/CWPF-MultiBinding-%EC%97%98%EB%A6%AC%EB%A8%BC%ED%8A%B8-Converter-%EC%86%8D%EC%84%B1%EC%97%90%EC%84%9C-IMultiValueConverter-%EC%9D%B8%ED%84%B0%ED%8E%98%EC%9D%B4%EC%8A%A4-%EA%B5%AC%ED%98%84-%EA%B0%9D%EC%B2%B4%EB%A5%BC-%EC%82%AC%EC%9A%A9%ED%95%B4-%EB%B0%94%EC%9D%B8%EB%94%A9%ED%95%98%EA%B8%B0-2  -->
                                                        <MultiBinding Converter="{StaticResource ExplorerConverter}">
                                                            <Binding Path="exp_ProjectId" />
                                                            <Binding Path="exp_TeamId"    />
                                                            <Binding Path="exp_FolderId"  />
                                                        </MultiBinding>
                                                    </Button.CommandParameter>
                                                    
