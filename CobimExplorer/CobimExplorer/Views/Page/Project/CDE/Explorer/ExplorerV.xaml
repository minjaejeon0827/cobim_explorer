                                                            <Binding Path="exp_TeamId" ElementName="FolderInfo" />
                                                            <Binding Path="exp_TreeFolderId" ElementName="FolderInfo" />
                                                        </MultiBinding>
                                                    </Button.CommandParameter>  -->
                                                </Button>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
