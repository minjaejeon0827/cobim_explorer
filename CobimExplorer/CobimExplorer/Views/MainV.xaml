<!--  TODO : MainV.xaml 윈도우 상단 타이틀 바 배경(Background color) 및 최소(MinButton), 최대(MaxButton), 축소(RestoreButton), 종료(ExitButton) 버튼 작동 오류 해결할 수 있도록 아래 참고 URL 보고 수정 예정 (2023.12.11 minjae)  -->
<!--  참고 URL - https://stackoverflow.com/questions/1283006/changing-wpf-title-bar-background-color  -->
<!--  참고 2 URL - https://www.codeproject.com/Articles/5255192/Use-WindowChrome-to-Customize-the-Title-Bar-in-WPF  -->
<Window x:Class="CobimExplorer.Views.MainV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:s="https://github.com/canton7/Stylet"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CobimExplorer.ViewModels"
        xmlns:local="clr-namespace:CobimExplorer" 
        Title="{Binding CDE_Title}"
        mc:Ignorable="d"
        x:Name="root"
        s:View.ActionTarget="{Binding MainVM}"
        d:DataContext="{d:DesignInstance Type=vm:MainVM}"
        d:DesignHeight="450"
        d:DesignWidth="800">

    <!--  TODO : 스크롤바 색상 변경 및 스타일 속성 구현 하기 (2023.12.11 minjae)  -->
    <!--  참고 URL - https://www.codeproject.com/Articles/37366/Styling-A-ScrollViewer-Scrollbar-In-WPF -->

    <!--  WindowStyle="None"
          AllowsTransparency="True"
          ResizeMode="CanResize"  -->
    <!--  StateChanged="Window_StateChanged" 
          LocationChanged="Window_LocationChanged"  -->
    <!--  StateChanged="Window_StateChanged"  -->
    <!--  ResizeMode="CanMinimize"  -->
    <!--  TODO : 윈도우 타이틀 바(Window chrome) <WindowChrome.WindowChrome> 영역 구현 (2023.12.11 minjae)  -->
    <!--  참고 URL - https://stackoverflow.com/questions/1283006/changing-wpf-title-bar-background-color  -->
    <!--  참고 2 URL - https://www.codeproject.com/Articles/5255192/Use-WindowChrome-to-Customize-the-Title-Bar-in-WPF  -->
    <WindowChrome.WindowChrome>
        <!--  <WindowChrome CaptionHeight="25" 
                            ResizeBorderThickness="2"/>  -->
        <WindowChrome CaptionHeight="34" />
    </WindowChrome.WindowChrome>

    <!--  TODO : 윈도우 타이틀 바(Window chrome) CommandBindings 구현 (2023.12.11 minjae)  -->
    <!--  참고 URL - https://stackoverflow.com/questions/1283006/changing-wpf-title-bar-background-color  -->
    <!--  참고 2 URL - https://www.codeproject.com/Articles/5255192/Use-WindowChrome-to-Customize-the-Title-Bar-in-WPF  -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CanExecute" Executed="MinimizeApp" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CanExecute" Executed="MaximizeApp" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}"  CanExecute="CanExecute" Executed="RestoreApp" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}"    CanExecute="CanExecute" Executed="CloseApp" />
    </Window.CommandBindings>

    <!--  TODO : C# WPF 팁 - Xaml 안에서 ViewModel속성을 자동완성 되도록 만들기(d:DataContext="{d:DesignInstance Type=vm:MainVM}") (2023.07.17 minjae)  -->
    <!--  유튜브 참고 URL - https://youtu.be/A8t5ktSAgdA -->

    <!--  TODO : BoolToVisibilityConverter 필요시 추후 사용 예정 (2023.07.17 minjae)  -->
    <!--  참고 URL - https://github.com/canton7/Stylet/wiki/BoolToVisibilityConverter  -->
    <Window.Resources>
        <s:BoolToVisibilityConverter x:Key="boolToVisConverter" TrueVisibility="Visible" FalseVisibility="Hidden"/>
        <!--  <TextBlock Visibility="{Binding SomeBoolProperty, Converter={StaticResource boolToVisConverter}}"/>  -->
    </Window.Resources>

    <Border x:Name="mainBorder" BorderBrush="{StaticResource App.Brush.Themes.Winter.Black.30}" BorderThickness="1">
        <DockPanel x:Name="parentContainer">
            <!--  TODO : 윈도우 타이틀 바(Window chrome) 영역 구현 (2023.12.11 minjae)  -->
            <!--  참고 URL - https://stackoverflow.com/questions/1283006/changing-wpf-title-bar-background-color  -->
            <!--  참고 2 URL - https://www.codeproject.com/Articles/5255192/Use-WindowChrome-to-Customize-the-Title-Bar-in-WPF  -->
            <!--  윈도우 타이틀 바 (Window chrome) 영역  -->
            <!--  TODO : 아래 주석친 직접 구현한 타이틀 바 (c:TitleBarControl) 필요시 사용 예정 (2023.12.11 minjae)  -->
            <!--  <c:TitleBarControl Grid.Row="0" />  -->
            <Grid x:Name="TitleBar" 
                  DockPanel.Dock="Top"
                  Height="30" 
                  Background="{StaticResource App.Brush.Themes.Winter.Black.30}">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center">
                    <!--  App icon  -->
                    <!--  <Image Source="/Resources/watermelon.ico" Width="18" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center" />  -->
                    <TextBlock Text="{Binding MainTitle}" 
                               FontFamily="Arial" 
                               Margin="5" 
                               FontWeight="Bold"
                               Foreground="{StaticResource App.Brush.Themes.Common.White}" />
                </StackPanel>

                
                <!--  Caption buttons  -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!--  환영 메시지(Welcome back)  -->
                    <TextBlock Text="{Binding WelcomeBack}" 
                               Width="Auto" 
                               Margin="5"
                               Foreground="{StaticResource App.Brush.Themes.Common.White}" />

                    <!--  로그인 사용자 아이디  -->
                    <TextBlock Text="{Binding LoginId}" 
                               Width="Auto" 
                               Margin="5"
                               Foreground="{StaticResource App.Brush.Themes.Common.White}"/>

                    <!--  버튼 - 최소화(-)  -->
                    <Button x:Name="MinButton"
                            ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Min}" 
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}" />

                    <!--  버튼 - 화면 원래 크기로 변환  -->
                    <Button x:Name="RestoreButton" 
                            Visibility="Collapsed" 
                            ToolTip="Restore"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Restore}" 
                            Command="{x:Static SystemCommands.RestoreWindowCommand}" />

                    <!--  버튼 - 최대화(□) -->
                    <Button x:Name="MaximizeButton" 
                            ToolTip="Maximize"
                            Visibility="Visible" 
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Max}" 
                            Command="{x:Static SystemCommands.MaximizeWindowCommand}" />

                    <!--  버튼 - 닫기(X) -->
                    <Button x:Name="CloseButton"
                            ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Close}" 
                            Command="{x:Static SystemCommands.CloseWindowCommand}" />
                </StackPanel>
            </Grid>

            <!--  TabControl - TabItems 화면 영역  -->
            <!--  TODO : ContentControl 사용해서 리본 탭의 버튼 클릭시  -->
            <!--         해당 버튼과 연동된 화면 (예) 탐색기 화면 - ExplorerV 출력 및 뷰모델(탐색기 화면 뷰모델 - ExplorerVM) 연동 구현 (2023.11.07 minjae)  -->
            <!--  참고 URL - https://github.com/canton7/Stylet/wiki/ViewModel-First  -->
            <!--  <Grid x:Name="PageArea" Grid.Row="2">  -->
            <Grid x:Name="PageArea" DockPanel.Dock="Bottom">  
            <!--  <Border x:Name="PageArea" DockPanel.Dock="Bottom">  -->
                <!--  TODO : 아래 주석친 <ContentControl> 사용 예제 필요시 참고 (2024.08.05 minjae)  -->
                <!--  <ContentControl Content="{Binding Page.Content}" s:View.Model="{Binding Page.DataContext}" />  -->
                <!--  <ContentControl s:View.Model="{Binding Page.DataContext}" />  -->
                <ContentControl s:View.Model="{Binding tabParentPageVM}" />
            <!--  </Border>  -->
            </Grid>  
        </DockPanel>
    </Border>

    <!--  TODO : 아래 주석친 테스트 코드 필요시 참고 (2024.09.09 minjae)  -->
    <!--<Border x:Name="mainBorder">
        <Grid x:Name="parentContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>

            --><!--  TODO : 윈도우 타이틀 바(Window chrome) 영역 구현 (2023.12.11 minjae)  -->
            <!--  참고 URL - https://stackoverflow.com/questions/1283006/changing-wpf-title-bar-background-color  -->
            <!--  참고 2 URL - https://www.codeproject.com/Articles/5255192/Use-WindowChrome-to-Customize-the-Title-Bar-in-WPF  -->
            <!--  윈도우 타이틀 바 (Window chrome) 영역  -->
            <!--  TODO : 아래 주석친 직접 구현한 타이틀 바 (c:TitleBarControl) 필요시 사용 예정 (2023.12.11 minjae)  -->
            <!--  <c:TitleBarControl Grid.Row="0" />  --><!--
            <Grid x:Name="TitleBar" 
                  Grid.Row="0" 
                  Height="30" 
                  Background="{StaticResource App.Brush.Themes.Spring.Green.60}">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center">
                    --><!--  App icon  -->
                    <!--  <Image Source="/Resources/watermelon.ico" Width="18" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center" />  --><!--
                    <TextBlock Text="{Binding MainTitle}" 
                               FontFamily="Arial" 
                               Margin="5" 
                               FontWeight="Bold"
                               Foreground="{StaticResource App.Brush.Themes.Common.White}" />
                </StackPanel>
                
                --><!--  Caption buttons  --><!--
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    --><!--  버튼 - 최소화(-)  --><!--
                    <Button x:Name="MinButton"
                            ToolTip="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Min}" 
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}" />

                    --><!--  버튼 - 화면 원래 크기로 변환  --><!--
                    <Button x:Name="RestoreButton" 
                            Visibility="Collapsed" 
                            ToolTip="Restore"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Restore}" 
                            Command="{x:Static SystemCommands.RestoreWindowCommand}" />

                    --><!--  버튼 - 최대화(□) --><!--
                    <Button x:Name="MaximizeButton" 
                            ToolTip="Maximize"
                            Visibility="Visible" 
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Max}" 
                            Command="{x:Static SystemCommands.MaximizeWindowCommand}" />
                    
                    --><!--  버튼 - 닫기(X) --><!--
                    <Button x:Name="CloseButton"
                            ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" 
                            Style="{StaticResource App.Button.System.Close}" 
                            Command="{x:Static SystemCommands.CloseWindowCommand}" />
                </StackPanel>
            </Grid>

            --><!--  TabControl - TabItems 화면 영역  -->
            <!--  TODO : ContentControl 사용해서 리본 탭의 버튼 클릭시  --> 
            <!--         해당 버튼과 연동된 화면 (예) 탐색기 화면 - ExplorerV 출력 및 뷰모델(탐색기 화면 뷰모델 - ExplorerVM) 연동 구현 (2023.11.07 minjae)  -->
            <!--  참고 URL - https://github.com/canton7/Stylet/wiki/ViewModel-First  --><!--
            <Grid x:Name="PageArea" Grid.Row="2">
                --><!--  TODO : 아래 주석친 <ContentControl> 사용 예제 필요시 참고 (2024.08.05 minjae)  -->
                <!--  <ContentControl Content="{Binding Page.Content}" s:View.Model="{Binding Page.DataContext}" />  -->
                <!--  <ContentControl s:View.Model="{Binding Page.DataContext}" />  --><!--
                <ContentControl s:View.Model="{Binding tabParentPageVM}" />
            </Grid>
        </Grid>
    </Border>-->
</Window>