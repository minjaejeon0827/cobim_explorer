            </ribbon:RibbonGroup>
            <ribbon:RibbonGroup x:Name="GroupEditor" Header="TestEditor">
            </ribbon:RibbonGroup>
        </ribbon:RibbonTab>--><!--
        <ribbon:RibbonTab Header="{Binding CDE_RibbonTab}" KeyTip="E">
            --><!--  TODO : 리본 그룹 "TestGroupExpVM" 필요시 사용 예정 (2023.11.07 minjae)  -->
            <!--<ribbon:RibbonGroup x:Name="TestGroupExpVM" Header="TestExplorerVM">
                <Button Width="100" Height="30" Command="{Binding TestExpVMCommand}" CommandParameter="TestExplorerVM">Test Explorer</Button>
            </ribbon:RibbonGroup>--><!--
            <ribbon:RibbonGroup x:Name="GroupExpVM" Header="{Binding CDE_RibbonGroup}">
                <Button Margin="5,20,5,0"
                        Width="100" 
                        Height="30" 
                        Command="{Binding ExpVMCommand}" 
                        CommandParameter="ExplorerVM">
                    <TextBlock Text="{Binding CDE_RibbonButton}" /> 
                </Button>
            </ribbon:RibbonGroup>
            --><!--  TODO : 리본 그룹 "GroupLazyTreeVM" 필요시 사용 예정 (2023.11.07 minjae)  -->
            <!--<ribbon:RibbonGroup x:Name="GroupLazyTreeVM" Header="TestLazyTreeVM">
                <Button Width="100" Height="30" Command="{Binding TestLazyTreeVMCommand}" CommandParameter="TestLazyTreeVM">Test LazyTree</Button>
            </ribbon:RibbonGroup>--><!--
        </ribbon:RibbonTab>
    </ribbon:Ribbon>-->
</UserControl>
