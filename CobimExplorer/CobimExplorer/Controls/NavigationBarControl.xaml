<UserControl x:Class="CobimExplorer.Controls.NavigationBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CobimExplorer.ViewModels.Page.Parents"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:local="clr-namespace:CobimExplorer.Controls"
             mc:Ignorable="d" 
             s:View.ActionTarget="{Binding TabParentPageVM}"
             d:DataContext="{d:DesignInstance Type=vm:TabParentPageVM}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!--  TODO : 내비게이션 바 우측에 화살표 모양 버튼(->) 추가 및 버튼 클릭시 아래 <StackPanel> 영역 Width = 0 또는 80 으로 변경하는 Trigger 또한 구현하기 (2024.09.10 minjae)  -->
        <StackPanel Background="{StaticResource App.Brush.Themes.Winter.Gray.10}"
                    Width="80"
                    Orientation="Vertical"
                    HorizontalAlignment="Left">
            <!--  성과품(CDE)  -->
            <!--  TODO : 버튼 기본 스타일(테두리, 배경 등등...) 제거 구현 (2023.11.13 minjae)  -->
            <!--  참고 URL - https://m.blog.naver.com/PostView.naver?isHttpsRedirect=true&blogId=skelentom&logNo=10166053623  -->
            <Button Margin="0,30,0,0"
                    Command="{Binding ExpVMCommand}" 
                    CommandParameter="ExplorerVM"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    ToolTip="{Binding CDE_NavButton}"
                    HorizontalContentAlignment="Center"
                    Width="48"
                    Height="48">
                <Button.Content>
                    <Image x:Name="CDEImg" Source="/Resources/CDE.png" />
                </Button.Content>
            </Button>

            <TextBlock Text="{Binding CDE_NavButton}" 
                       TextAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{StaticResource App.Brush.Themes.Winter.Black.10}" />

            <!--  HubBox  -->
            <!--  TODO : 버튼 기본 스타일(테두리, 배경 등등...) 제거 구현 (2024.08.07 minjae)  -->
            <!--  참고 URL - https://m.blog.naver.com/PostView.naver?isHttpsRedirect=true&blogId=skelentom&logNo=10166053623  -->
            <Button Margin="0,30,0,0"
                    Command="{Binding HubBoxVMCommand}" 
                    CommandParameter="HubBoxVM"
                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                    ToolTip="{Binding HubBox_NavButton}"
                    HorizontalContentAlignment="Center"
                    Width="48"
                    Height="48">
                <Button.Content>
                    <Image x:Name="HubBoxImg" Source="/Resources/HubBox.png" />
                </Button.Content>
            </Button>

            <TextBlock Text="{Binding HubBox_NavButton}" 
                       TextAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{StaticResource App.Brush.Themes.Winter.Black.10}" />  
        </StackPanel>
    </Grid>
</UserControl>
