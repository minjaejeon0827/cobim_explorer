<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  { StackResource } {DynamicResource }의 차이는 {StackResource }는 컴파일 실행할 때, 해당 솔루션의 존재하는 다른 로직(소스파일)에서  -->
    <!--  구현된 Resources(자원)들을 가져오는 기능이고, {DynamicResource }는 컴파일 실행 후, 프로그램이 정상 실행되는 런타임 동안에  -->
    <!--  실시간으로 데이터가 바뀌거나 화면이 새로 랜더링 되는(화면 변환) 동안에 동적으로 그때마다 필요한 Resource(자원)들을 가져오는 기능이다. -->

    <!--  색상 상수화 선언  -->
    <Color x:Key="App.Color.Transparent">Transparent</Color>
    <Color x:Key="App.Color.Red">Red</Color>
    <Color x:Key="App.Color.Green">Green</Color>
    <Color x:Key="App.Color.Blue">Blue</Color>
    <Color x:Key="App.Color.LightGray">LightGray</Color>
    <Color x:Key="App.Color.Chocolate">Chocolate</Color>

    <Color x:Key="App.Color.LightPink">LightPink</Color>
    <Color x:Key="App.Color.HotPink">HotPink</Color>
    <Color x:Key="App.Color.Border.Background">#FFFFF6F7</Color>

    <Color x:Key="App.Color.Gold">Gold</Color>
    <Color x:Key="App.Color.GreenYellow">GreenYellow</Color>
    <Color x:Key="App.Color.Yellow">Yellow</Color>

    <Color x:Key="App.Color.ItemAreaBrush.10">#22000000</Color>
    <Color x:Key="App.Color.ItemAreaBrush.30">#66000000</Color>
</ResourceDictionary>