<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- {StackResource } {DynamicResource }의 차이는 {StackResource }는 컴파일 실행할 때, 해당 솔루션의 존재하는 다른 로직(소스파일)에서  -->
    <!-- 구현된 Resources(자원)들을 가져오는 기능이고, {DynamicResource }는 컴파일 실행 후, 프로그램이 정상 실행되는 런타임 동안에  -->
    <!-- 실시간으로 데이터가 바뀌거나 화면이 새로 랜더링 되는(화면 변환) 동안에 동적으로 그때마다 필요한 Resource(자원)들을 가져오는 기능이다. -->
    
    <!--  TODO : TreeView 수평방향으로 스타일 구현 (2023.10.30 jbh)  -->
    <!--  참고 URL   - https://stackoverflow.com/questions/364083/wpf-treeview-with-horizontal-orientation  -->  
    <!--  참고 2 URL - https://www.codeproject.com/Articles/17025/Custom-TreeView-Layout-in-WPF  --> 
    <!--  참고 3 URL - https://www.generacodice.com/ko/articolo/169565/%EC%88%98%ED%8F%89-%EB%B0%A9%ED%96%A5%EC%9D%B4%EC%9E%88%EB%8A%94-wpf-%ED%8A%B8%EB%A6%AC-%EB%B7%B0  -->

    <!--  This Style redefines the ControlTemplate used by TreeViewItems and
          also provides a different itemspanel for their child items.  -->
    <!--  이 스타일은 TreeViewItems에서 사용되는 ControlTemplate을 재정의하고
          또한 하위 항목에 대해 다른 항목 패널을 제공합니다.  -->
    <Style x:Key="App.TreeViewItem.Horizontality" BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="{x:Type TreeViewItem}">
        <!--  Resources 영역  -->
        <Style.Resources>
            <!--  TODO : TreeViewItem에 속하는 각각의 데이터가 출력되는 컨트롤(TextBlock)을 Background 속성에 그라데이션 적용 (2023.10.30 jbh)  -->
            <!--  참고 URL - https://wpfstory.tistory.com/15  -->
            <LinearGradientBrush x:Key="ItemAreaBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
                <!--  TODO : 아래 주석친 <GradientStop> 소스 코드 필요시 사용 예정 (2023.12.12 jbh)  -->
                <!--  <GradientStop Color="{DynamicResource App.Color.ItemAreaBrush.30}" Offset="0" />  -->  
                <!--  <GradientStop Color="{DynamicResource App.Color.ItemAreaBrush.10}" Offset="1" />  -->  
                <GradientStop Color="{DynamicResource App.Color.Themes.Fall.Brown}" Offset="0"   />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SelectedItemAreaBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
                <GradientStop Color="{DynamicResource App.Color.Green}" Offset="0"       />
                <GradientStop Color="{DynamicResource App.Color.GreenYellow}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ItemBorderBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
                <!--  TODO : 아래 주석친 <GradientStop> 소스 코드 필요시 사용 예정 (2023.12.12 jbh)  -->
                <!--  <GradientStop Color="{DynamicResource App.Color.LightGray}" Offset="0" />  -->
                <!--  <GradientStop Color="{DynamicResource App.Color.Themes.Common.Gray}" Offset="1"      />  -->
                <GradientStop Color="{DynamicResource App.Color.Themes.Common.NavajoWhite}" Offset="0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SelectedItemBorderBrush" StartPoint="0.5, 0" EndPoint="0.5, 1">
                <GradientStop Color="{DynamicResource App.Color.Yellow}" Offset="0" />
                <GradientStop Color="{DynamicResource App.Color.Themes.Common.Black}" Offset="1" />
            </LinearGradientBrush>
            <DropShadowBitmapEffect x:Key="DropShadowEffect" />
        </Style.Resources>

        <!--  TODO : 각각의 TreeViewItem 사이의 Margin 설정 (2023.11.01 jbh)  -->
        <!--  참고 URL - https://stackoverflow.com/questions/2552814/increase-the-spacing-between-treeviewitems-in-a-treeview  -->
        <Setter Property="Margin" Value="5 5 5 5"/>

        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                IsItemsHost="True" 
                                Margin="4,6" 
                                Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
            
        <!--  Template 영역  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TreeViewItem}">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <!-- TODO : <RowDefinition>영역에서 Height 가중치 구현 (2023.10.30 jbh) -->
                            <!-- 참고 URL - https://benstagram.tistory.com/33 -->

                            <!--  The top row contains the item's content.  -->
                            <!--  맨 위 행에는 항목의 내용이 포함  -->
                            <RowDefinition Height="Auto"  />

                            <!--  The bottom row contains the item's children.  -->
                            <!--  맨 아래 행에는 항목의 하위 항목이 포함  -->
                            <RowDefinition Height="*"  />
                        </Grid.RowDefinitions>

                        <!--  This Border and ContentPresenter displays the content of the TreeViewItem.  -->
                        <!--  이 Border 및 ContentPresenter는 TreeViewItem의 콘텐츠 표시  -->
                        <!--  TODO : TreeViewItem 선택하였을 때, BorderThickness (Border 테두리 두께) Value="3" 설정 (2023.10.30 jbh)  -->
                        <Border Name="TreeViewItemBorder" 
                                Background="{StaticResource ItemAreaBrush}"
                                BorderBrush="{StaticResource ItemBorderBrush}" 
                                BorderThickness="3" 
                                CornerRadius="8"
                                Padding="6"
                                Width="240">
                            <ContentPresenter Name="PART_Header"                  
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"  />
                        </Border>

                        <!--  The ItemsPresenter displays the item's children.  -->
                        <!--  ItemsPresenter는 항목의 하위 항목 표시  -->
                        <ItemsPresenter Grid.Row="1"  />
                    </Grid>

                    <!--  Triggers 영역  -->
                    <ControlTemplate.Triggers>
                        <!--  When the item is selected in the TreeView, 
                              use the "selected" colors and give it a drop shadow.  -->
                        <!--  TreeView에서 항목 선택시 "선택한" 색상 사용 및 그림자 처리  -->
                        <Trigger Property="IsSelected" Value="True">
                            <!--  TreeViewItem 선택하였을 때, Background 색상 (Green - GreenYellow 계열) 변경 (2023.10.30 jbh)  -->
                            <Setter TargetName="TreeViewItemBorder"
                                    Property="Panel.Background"                     
                                    Value="{DynamicResource SelectedItemAreaBrush}" />

                            <!--  TreeViewItem 선택하였을 때, BorderBrush (Border 테두리) 색상(Yellow - Black 계열) 변경 (2023.10.30 jbh)  -->
                            <Setter TargetName="TreeViewItemBorder"
                                    Property="Border.BorderBrush"                     
                                    Value="{DynamicResource SelectedItemBorderBrush}" />

                            <!--  TreeViewItem 선택하였을 때, BorderThickness (Border 테두리 두께) Value="3" 변경 (2023.10.30 jbh)  -->
                            <!--<Setter TargetName="TreeViewItemBorder"
                                    Property="Border.BorderThickness"                     
                                    Value="3"  />-->

                            <!--  TreeViewItem 선택하였을 때, 데이터 출력하는 TextBlock ("Foreground" - 글자 색상) 하얀색(SystemColors.HighlightTextBrushKey) 변경 (2023.10.30 jbh)  -->
                            <Setter TargetName="TreeViewItemBorder"
                                    Property="TextElement.Foreground"                   
                                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />

                            <!--  TODO : TreeViewItem 선택하였을 때, 그림자 처리(Border.BitmapEffect) 필요시 구현 예정 (2023.10.30 jbh) -->
                            <!--  <Setter TargetName="TreeViewItemBorder"
                                          Property="Border.BitmapEffect"                  
                                          Value="{StaticResource DropShadowEffect}" />  -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  Make each TreeViewItem show it's children in a horizontal StackPanel.  -->
        <!--  각 TreeViewItem이 수평 StackPanel의 하위 항목을 표시하도록 처리  -->
        <!--  ItemsPanel 영역  -->
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Center"
                                IsItemsHost="True"
                                Margin="4,6"
                                Orientation="Horizontal"  />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>